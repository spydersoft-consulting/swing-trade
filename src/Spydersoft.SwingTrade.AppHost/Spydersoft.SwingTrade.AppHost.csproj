    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>swing-trade-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\api\src\Spydersoft.SwingTrade.Api\Spydersoft.SwingTrade.Api.csproj" />
    <ProjectReference Include="..\web\src\Spydersoft.SwingTrade.Frontend\Spydersoft.SwingTrade.Frontend.csproj" />
  </ItemGroup>

</Project>
