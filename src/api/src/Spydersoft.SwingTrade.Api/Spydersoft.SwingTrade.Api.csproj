<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>swing-trade-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spydersoft.Platform.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spydersoft.SwingTrade.Contracts\Spydersoft.SwingTrade.Contracts.csproj" />
    <ProjectReference Include="..\Spydersoft.SwingTrade.Data\Spydersoft.SwingTrade.Data.csproj" />
    <ProjectReference Include="..\Spydersoft.SwingTrade.MarketData\Spydersoft.SwingTrade.MarketData.csproj" />
    <ProjectReference Include="..\Spydersoft.SwingTrade.Rules\Spydersoft.SwingTrade.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spydersoft.SwingTrade.Api.UnitTests" />
  </ItemGroup>

</Project>
