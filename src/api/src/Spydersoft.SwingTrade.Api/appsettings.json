{
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "https://auth.mattgerega.net"
  },
  "Refresh": {
    "ScheduleEnabled": true
  },
  "HealthCheck": {
    "LiveTags": [],
    "ReadyTags": [],
    "StartupTags": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "swingtrade.api",
    "Log": {
      "Type": "otlp"
    },
    "MeterName": "swingtrade.api",
    "Metrics": {
      "Type": "otlp"
    },
    "ServiceName": "swingtrade.api",
    "Trace": {
      "Type": "otlp"
    }
  }
}
