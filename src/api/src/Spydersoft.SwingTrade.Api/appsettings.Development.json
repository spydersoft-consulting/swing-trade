{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  },
  "Telemetry": {
    "Log": {
      "Type": "console"
    },
    "Metrics": {
      "Type": "console"
    },
    "Trace": {
      "Type": "console"
    }
  }
}
