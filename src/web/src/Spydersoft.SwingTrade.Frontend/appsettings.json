{
  "AllowedHosts": "*",
  "HealthCheck": {
    "LiveTags": "live",
    "ReadyTags": "ready",
    "StartupTags": "startup"
  },
  "OidcProxySettings": {
    "CookieMaxAge": "30.00:00:00",
    "CookieName": "swingtrade.session",
    "Oidc": {
      "Authority": "https://auth.mattgerega.net",
      "DisablePushedAuthorization": true,
      "Scopes": [
        "openid",
        "profile",
        "email",
        "offline_access",
        "swingtrade"
      ]
    },
    "ReverseProxy": {
      "Clusters": {
        "swingTradeApi": {
          "Destinations": {
            "destination1": {
              "Address": "http://swing-trade-api/"
            }
          }
        }
      },
      "Routes": {
        "api": {
          "AllowAnonymous": false,
          "ClusterId": "swingTradeApi",
          "Match": {
            "Path": "/api/v1/{**catch-all}"
          }
        }
      }
    },
    "SessionIdleTimeout": "30.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "swingtrade.web",
    "Log": {
      "Type": "otlp"
    },
    "MeterName": "swingtrade.web",
    "Metrics": {
      "Type": "otlp"
    },
    "ServiceName": "swingtrade.web",
    "Trace": {
      "Type": "otlp"
    }
  }
}
