{
  "name": "swing-trade-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:fix": "eslint --report-unused-disable-directives --max-warnings 0 --fix && prettier --write .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0 && prettier --check .",
    "preview": "vite preview",
    "test-ui": "vitest --ui --coverage",
    "test": "vitest --reporter=verbose",
    "test-ci": "vitest run --reporter junit --coverage",
    "api:spec": "dotnet build ../../../api/src/Spydersoft.SwingTrade.Api -p:GenerateOpenApi=true",
    "api:generate": "openapi-ts",
    "api:update": "yarn api:spec && yarn api:generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hey-api/client-axios": "^0.9.1",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^25.8.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
